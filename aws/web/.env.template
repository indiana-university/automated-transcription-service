# Copy to `.env` and fill from `terraform output` (run in ../terraform).
# Do NOT commit .env — it is git-ignored.

# AWS region the buckets and Cognito pools are deployed in
VITE_AWS_REGION=us-east-1

# Terraform output: cognito_user_pool_id
VITE_USER_POOL_ID=

# Terraform output: cognito_user_pool_client_id
VITE_USER_POOL_CLIENT_ID=

# Terraform output: cognito_identity_pool_id
VITE_IDENTITY_POOL_ID=

# Terraform output: cognito_domain
VITE_COGNITO_DOMAIN=

# Terraform output: saml_provider_name
VITE_SAML_PROVIDER=SSO

# Terraform output: upload_bucket_name
VITE_UPLOAD_BUCKET=

# Terraform output: download_bucket_name
VITE_DOWNLOAD_BUCKET=
